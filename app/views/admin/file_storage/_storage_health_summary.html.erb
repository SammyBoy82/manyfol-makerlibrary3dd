<div class="card mb-4">

  <div class="card-header d-flex justify-content-between align-items-center">

    <div>
      <strong>Storage Health</strong>

      <div class="small text-muted">
        Live accessibility combined with persistent connection-test results.
      </div>
    </div>


  </div>


  <div class="card-body">

    <div class="row g-3">

      <div class="col-md-3">
        <div class="border rounded p-3 h-100">
          <div class="small text-muted">
            Healthy
          </div>

          <div class="fs-3">
            <%= @storage_health_summary[:healthy] %>
            /
            <%= @storage_health_summary[:total] %>
          </div>
        </div>
      </div>


      <div class="col-md-3">
        <div class="border rounded p-3 h-100">
          <div class="small text-muted">
            Attention Required
          </div>

          <div class="fs-3">
            <%= @storage_health_summary[:attention] %>
          </div>
        </div>
      </div>


      <div class="col-md-3">
        <div class="border rounded p-3 h-100">
          <div class="small text-muted">
            Offline
          </div>

          <div class="fs-3">
            <%= @storage_health_summary[:offline] %>
          </div>
        </div>
      </div>


      <div class="col-md-3">
        <div class="border rounded p-3 h-100">
          <div class="small text-muted">
            Last Health Check
          </div>

          <div class="fw-semibold mt-2">
            <% if @storage_health_summary[:latest_check] %>
              <%= @storage_health_summary[:latest_check]
                    .in_time_zone
                    .strftime("%Y-%m-%d %H:%M:%S") %>
            <% else %>
              Never
            <% end %>
          </div>
        </div>
      </div>

    </div>


    <% if @storage_health_summary[:attention].to_i > 0 %>

      <div class="alert alert-warning mt-3 mb-0">

        <strong>Storage attention required.</strong>

        One or more storage sources are offline, unreadable,
        or failed their latest connection test.

      </div>

    <% else %>

      <div class="alert alert-success mt-3 mb-0">

        <strong>All storage sources healthy.</strong>

        All configured storage sources are currently accessible
        and their latest health tests passed.

      </div>

    <% end %>


    <div class="table-responsive mt-3">

      <table class="table table-sm align-middle mb-0">

        <thead>
          <tr>
            <th>Source</th>
            <th>Live Status</th>
            <th>Health Test</th>
            <th>Last Checked</th>
          </tr>
        </thead>

        <tbody>

          <% @storage_sources.each do |source| %>

            <% health =
                 @storage_health_by_source[
                   source.key.to_s
                 ] || {} %>

            <% latest =
                 health[:latest] %>

            <tr>

              <td>
                <strong>
                  <%= source.name %>
                </strong>

                <div class="small text-muted">
                  <code><%= source.container_path %></code>
                </div>
              </td>


              <td>
                <% if source.available && source.readable %>
                  <span class="badge bg-success">
                    Online
                  </span>
                <% else %>
                  <span class="badge bg-danger">
                    Offline
                  </span>
                <% end %>
              </td>


              <td>
                <% if latest.nil? %>

                  <span class="badge bg-secondary">
                    Never Tested
                  </span>

                <% elsif latest.state.to_s == "passed" %>

                  <span class="badge bg-success">
                    Healthy
                  </span>

                <% else %>

                  <span class="badge bg-danger">
                    Failed
                  </span>

                <% end %>
              </td>


              <td>
                <% if latest&.updated_at %>
                  <%= latest.updated_at
                        .in_time_zone
                        .strftime("%Y-%m-%d %H:%M:%S") %>
                <% else %>
                  —
                <% end %>
              </td>

            </tr>

          <% end %>

        </tbody>

      </table>

    </div>

  </div>

</div>
