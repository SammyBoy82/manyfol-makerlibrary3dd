<div class="container-fluid py-4">

  <div class="d-flex justify-content-between align-items-start mb-4">
    <div>
      <h1 class="h3 mb-1">Storage Anomalies</h1>
      <p class="text-muted mb-0">
        Read-only diagnostics for registered files and physical library storage.
      </p>
    </div>

    <%= link_to "Back to File & Storage",
          admin_file_storage_path,
          class: "btn btn-outline-secondary" %>
  </div>


  <div class="alert alert-info">
    <strong>Storage terminology.</strong>

    <div class="mt-2">
      <strong>Registered:</strong>
      Manyfold has a database record representing the file.
    </div>

    <div>
      <strong>Unregistered Physical:</strong>
      the file physically exists in the library folder, but Manyfold does not currently have a database record for it.
    </div>

    <div>
      <strong>Registered but Missing:</strong>
      Manyfold has a database record for the file, but the physical source file can no longer be found on storage.
    </div>

    <div>
      <strong>Reconciliation Scan:</strong>
      asks Manyfold to discover physical files and create/update catalogue records. It does not delete physical files.
    </div>

    <div>
      <strong>Missing Record Cleanup:</strong>
      removes confirmed stale database records only after checking again that the physical source is still absent.
    </div>
  </div>


  <div class="row g-3 mb-4">

    <div class="col-md-3">
      <div class="card h-100 <%= @zero_byte_files.any? ? 'border-danger' : 'border-success' %>">
        <div class="card-body">
          <div class="text-muted small">Zero-byte Files</div>
          <div class="display-6"><%= @zero_byte_files.size %></div>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card h-100 <%= @missing_size_files.any? ? 'border-warning' : 'border-success' %>">
        <div class="card-body">
          <div class="text-muted small">Missing Size Metadata</div>
          <div class="display-6"><%= @missing_size_files.size %></div>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card h-100">
        <div class="card-body">
          <div class="text-muted small">Rare Extensions</div>
          <div class="display-6"><%= @rare_extensions.size %></div>
          <div class="small text-muted">≤ 3 registered files</div>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card h-100">
        <div class="card-body">
          <div class="text-muted small">Libraries</div>
          <div class="display-6"><%= @libraries.size %></div>
        </div>
      </div>
    </div>

  </div>


  <div class="card mb-4">

    <div class="card-header">
      <strong>Physical vs Database Comparison</strong>
    </div>

    <div class="card-body">

      <%= form_with url: admin_file_storage_anomalies_path,
            method: :get,
            local: true,
            class: "row g-2 align-items-end" do %>

        <div class="col-lg-8">

          <label class="form-label">
            Library
          </label>

          <%= select_tag :compare_library_id,
                options_from_collection_for_select(
                  @libraries,
                  :id,
                  :name,
                  @comparison_library&.id
                ),
                include_blank: "Select a library",
                class: "form-select" %>

        </div>

        <div class="col-lg-4 d-grid">

          <%= submit_tag "Run Physical Comparison",
                class: "btn btn-primary" %>

        </div>

      <% end %>

      <div class="form-text mt-2">
        This manually walks only the selected library.
        It does not scan every library automatically.
      </div>

    </div>

  </div>


  <% if @comparison %>

    <div class="card mb-4 border-primary">

      <div class="card-header">
        <strong>
          Comparison:
          <%= @comparison.library.name %>
        </strong>
      </div>

      <div class="card-body">

        <div class="row g-3 mb-4">

          <div class="col-md-3">
            <div class="text-muted small">
              <span title="All source files physically found inside this library on storage.">
                Physical Source Files
              </span>
            </div>

            <div class="h3">
              <%= number_with_delimiter(@comparison.physical_source_count) %>
            </div>
          </div>

          <div class="col-md-3">
            <div class="text-muted small">
              <span title="Files for which Manyfold currently has database records.">
                Registered Files
              </span>
            </div>

            <div class="h3">
              <%= number_with_delimiter(@comparison.registered_count) %>
            </div>
          </div>

          <div class="col-md-3">
            <div class="text-muted small">
              <span title="Files that physically exist on storage but do not currently have matching Manyfold database records.">
                Unregistered Physical
              </span>
            </div>

            <div class="h3 text-warning">
              <%= number_with_delimiter(@comparison.unregistered_count) %>
            </div>
          </div>

          <div class="col-md-3">
            <div class="text-muted small">
              <span title="Manyfold database records whose physical source files are no longer present on storage.">
                Registered but Missing
              </span>
            </div>

            <div class="h3 text-danger">
              <%= number_with_delimiter(@comparison.missing_registered_count) %>
            </div>
          </div>

        </div>


        <% if @comparison.physical_bytes %>

          <div class="mb-3">

            Physical source size:
            <strong>
              <%= number_to_human_size(@comparison.physical_bytes) %>
            </strong>

          </div>

        <% end %>

        <div class="alert alert-warning">
          <strong>Controlled reconciliation action.</strong>
          This queues Manyfold's native library scan for this library.
          It may create or update catalogue records for files that exist on storage,
          but it does not delete source files or remove database records.
        </div>

        <% if @comparison.missing_registered_count.positive? %>

          <div class="alert alert-danger">

            <strong>
              <%= number_with_delimiter(@comparison.missing_registered_count) %>
              registered record(s) point to missing source files.
            </strong>

            <div class="mt-2">
              Do not remove them automatically from this comparison page.
              Use the existing verified cleanup workflow, where each missing problem
              can be reviewed and selected before any database record is removed.
            </div>

            <div class="mt-3">

              <%= link_to "Review Missing Records Before Cleanup",
                    admin_integrity_preview_path("missing"),
                    class: "btn btn-outline-danger" %>

            </div>

          </div>

        <% end %>

        <div class="mb-4">

          <%= button_to "Queue Library Reconciliation Scan",
                admin_file_storage_reconcile_path(
                  library_id: @comparison.library.id
                ),
                method: :post,
                class: "btn btn-warning",
                data: {
                  turbo_confirm: "Queue a native Manyfold reconciliation scan for #{@comparison.library.name}? This may register newly discovered files and models. No physical files will be deleted."
                } %>

        </div>


        <div class="row g-4">

          <div class="col-xl-6">

            <div class="card h-100">

              <div class="card-header">
                <strong>Unregistered Physical Files</strong>

                <% if @comparison.unregistered_count > @comparison.unregistered_paths.size %>
                  <div class="small text-muted">
                    Showing first
                    <%= number_with_delimiter(@comparison.unregistered_paths.size) %>
                    of
                    <%= number_with_delimiter(@comparison.unregistered_count) %>.
                  </div>
                <% end %>
              </div>

              <div class="card-body">

                <% if @comparison.unregistered_paths.empty? %>

                  <span class="text-success">
                    None detected.
                  </span>

                <% else %>

                  <div style="max-height:500px;overflow:auto;">

                    <% @comparison.unregistered_paths.each do |path| %>

                      <div class="border-bottom py-1">
                        <code class="text-break">
                          <%= path %>
                        </code>
                      </div>

                    <% end %>

                  </div>

                <% end %>

              </div>

            </div>

          </div>


          <div class="col-xl-6">

            <div class="card h-100">

              <div class="card-header">
                <strong>Registered Records Missing on Storage</strong>

                <% if @comparison.missing_registered_count > @comparison.missing_registered_paths.size %>
                  <div class="small text-muted">
                    Showing first
                    <%= number_with_delimiter(@comparison.missing_registered_paths.size) %>
                    of
                    <%= number_with_delimiter(@comparison.missing_registered_count) %>.
                  </div>
                <% end %>
              </div>

              <div class="card-body">

                <% if @comparison.missing_registered_paths.empty? %>

                  <span class="text-success">
                    None detected.
                  </span>

                <% else %>

                  <div style="max-height:500px;overflow:auto;">

                    <% @comparison.missing_registered_paths.each do |path| %>

                      <div class="border-bottom py-1">
                        <code class="text-break">
                          <%= path %>
                        </code>
                      </div>

                    <% end %>

                  </div>

                <% end %>

              </div>

            </div>

          </div>

        </div>

      </div>

    </div>

  <% end %>


  <div class="row g-4 mb-4">


    <div class="col-xl-6">

      <div class="card h-100">

        <div class="card-header">
          <strong>Zero-byte Registered Files</strong>
        </div>

        <div class="table-responsive">

          <table class="table table-sm mb-0">

            <thead>
              <tr>
                <th>File</th>
                <th>Model</th>
                <th>Library</th>
              </tr>
            </thead>

            <tbody>

              <% @zero_byte_files.each do |file| %>

                <tr>

                  <td>
                    <code>
                      <%= file.filename %>
                    </code>
                  </td>

                  <td>
                    <%= link_to file.model.name,
                          model_path(file.model),
                          target: "_blank",
                          rel: "noopener" %>
                  </td>

                  <td>
                    <%= file.model.library.name %>
                  </td>

                </tr>

              <% end %>

              <% if @zero_byte_files.empty? %>

                <tr>
                  <td colspan="3" class="text-success">
                    No zero-byte registered files.
                  </td>
                </tr>

              <% end %>

            </tbody>

          </table>

        </div>

      </div>

    </div>


    <div class="col-xl-6">

      <div class="card h-100">

        <div class="card-header">
          <strong>Rare File Extensions</strong>
        </div>

        <div class="table-responsive">

          <table class="table table-sm mb-0">

            <thead>
              <tr>
                <th>Extension</th>
                <th class="text-end">Files</th>
                <th class="text-end">Registered Size</th>
              </tr>
            </thead>

            <tbody>

              <% @rare_extensions.each do |row| %>

                <tr>

                  <td>
                    <code>
                      <%= row.extension.upcase %>
                    </code>
                  </td>

                  <td class="text-end">
                    <%= row.files %>
                  </td>

                  <td class="text-end">
                    <%= number_to_human_size(row.bytes) %>
                  </td>

                </tr>

              <% end %>

            </tbody>

          </table>

        </div>

      </div>

    </div>

  </div>


  <div class="row g-4">


    <div class="col-xl-6">

      <div class="card">

        <div class="card-header">
          <strong>Top 50 Largest Files</strong>
        </div>

        <div class="table-responsive">

          <table class="table table-sm mb-0">

            <thead>
              <tr>
                <th>File</th>
                <th>Library</th>
                <th class="text-end">Size</th>
              </tr>
            </thead>

            <tbody>

              <% @largest_files.each do |file| %>

                <tr>

                  <td>
                    <strong>
                      <%= file.filename %>
                    </strong>

                    <div class="small text-muted">
                      <%= file.model.name %>
                    </div>
                  </td>

                  <td>
                    <%= file.model.library.name %>
                  </td>

                  <td class="text-end">
                    <%= number_to_human_size(file.size.to_i) %>
                  </td>

                </tr>

              <% end %>

            </tbody>

          </table>

        </div>

      </div>

    </div>


    <div class="col-xl-6">

      <div class="card">

        <div class="card-header">
          <strong>Top 50 Largest Models / Folders</strong>
        </div>

        <div class="table-responsive">

          <table class="table table-sm mb-0">

            <thead>
              <tr>
                <th>Model</th>
                <th>Files</th>
                <th class="text-end">Size</th>
              </tr>
            </thead>

            <tbody>

              <% @largest_models.each do |row| %>

                <tr>

                  <td>

                    <%= link_to row[:model].name,
                          model_path(row[:model]),
                          target: "_blank",
                          rel: "noopener" %>

                    <div class="small text-muted">
                      <%= row[:library].name %>
                    </div>

                  </td>

                  <td>
                    <%= row[:files] %>
                  </td>

                  <td class="text-end">
                    <%= number_to_human_size(row[:bytes]) %>
                  </td>

                </tr>

              <% end %>

            </tbody>

          </table>

        </div>

      </div>

    </div>

  </div>

</div>
