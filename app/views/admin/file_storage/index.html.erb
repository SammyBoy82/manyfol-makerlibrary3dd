<div class="container-fluid py-4">

  <div class="d-flex justify-content-between align-items-start mb-4">
    <div>
      <h1 class="h3 mb-1">File & Storage Intelligence</h1>
      <p class="text-muted mb-0">
        Read-only catalogue, library capacity and storage intelligence for MakerLibrary3D.
      </p>
    </div>

    <div class="d-flex gap-2">
      <%= link_to "Back to Settings",
            settings_path,
            class: "btn btn-outline-secondary" %>
    </div>
  </div>

  <div class="card mb-4 border-primary">
    <div class="card-body">
      <h2 class="h5 mb-1">Storage operations</h2>
      <p class="small text-muted mb-3">Add, test and review storage sources. Activity history is at the end of this page.</p>
      <div class="d-flex flex-wrap gap-2">
        <%= link_to "Add Storage Source", new_admin_storage_source_path, class: "btn btn-primary" %>
        <%= link_to "SMB / Azure Files", new_admin_storage_source_path(provider: "smb"), class: "btn btn-outline-primary" %>
        <%= button_to "Run All Health Checks", run_all_admin_storage_health_path, method: :post, class: "btn btn-outline-success" %>
        <%= link_to "Storage Anomalies", admin_file_storage_anomalies_path, class: "btn btn-outline-warning" %>
        <%= link_to "View Activity ↓", "#storage-activity", class: "btn btn-outline-secondary" %>
      </div>
    </div>
  </div>
  <%= render "admin/file_storage/storage_sources",
        sources: @storage_sources %>

  <!-- MAIN COUNTERS -->

  <div class="row g-3 mb-4">

    <div class="col-md-2">
      <div class="card h-100">
        <div class="card-body">
          <div class="text-muted small">Catalogue Files</div>
          <div class="display-6"><%= @catalogue_file_count %></div>
        </div>
      </div>
    </div>

    <div class="col-md-2">
      <div class="card h-100">
        <div class="card-body">
          <div class="text-muted small">Shown</div>
          <div class="display-6"><%= @summary[:shown] %></div>
        </div>
      </div>
    </div>

    <div class="col-md-2">
      <div class="card h-100 border-success">
        <div class="card-body">
          <div class="text-muted small">Source Present</div>
          <div class="display-6"><%= @summary[:source_present] %></div>
        </div>
      </div>
    </div>

    <div class="col-md-2">
      <div class="card h-100 border-danger">
        <div class="card-body">
          <div class="text-muted small">Source Missing</div>
          <div class="display-6"><%= @summary[:source_missing] %></div>

          <% if @summary[:source_missing].positive? %>
            <%= link_to "Show missing",
                  admin_file_storage_path(
                    q: @query,
                    library_id: @library_id,
                    extension: @extension,
                    source_state: "missing"
                  ),
                  class: "small" %>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-md-2">
      <div class="card h-100">
        <div class="card-body">
          <div class="text-muted small">Cached Render</div>
          <div class="display-6"><%= @summary[:with_render] %></div>
        </div>
      </div>
    </div>

    <div class="col-md-2">
      <div class="card h-100">
        <div class="card-body">
          <div class="text-muted small">Shown Size</div>
          <div class="display-6 fs-4">
            <%= number_to_human_size(@summary[:bytes]) %>
          </div>
        </div>
      </div>
    </div>

  </div>


  <%= render "admin/file_storage/storage_health_summary" %>


  <!-- LIBRARY STORAGE -->

  <div class="card mb-4">

    <div class="card-header">
      <strong>Library Storage</strong>
    </div>

    <div class="table-responsive">
      <table class="table table-sm table-striped align-middle mb-0">

        <thead>
          <tr>
            <th>Library</th>
            <th>Storage</th>
            <th>Models</th>
            <th>Files</th>
            <th>Registered Size</th>
            <th>Filesystem Used</th>
            <th>Free</th>
            <th>Total</th>
            <th>Usage</th>
          </tr>
        </thead>

        <tbody>

          <% @library_stats.each do |row| %>

            <tr>

              <td>
                <strong><%= row.library.name %></strong>
                <div class="small text-muted">
                  <%= row.library.path %>
                </div>
              </td>

              <td>
                <code><%= row.library.storage_key %></code>
                <div class="small text-muted">
                  <%= row.library.storage_service %>
                </div>
              </td>

              <td><%= number_with_delimiter(row.models) %></td>

              <td>
                <%= link_to number_with_delimiter(row.files),
                      admin_file_storage_path(
                        library_id: row.library.id
                      ) %>
              </td>

              <td>
                <%= number_to_human_size(row.registered_bytes) %>
              </td>

              <td>
                <%= row.used_bytes ?
                      number_to_human_size(row.used_bytes) :
                      "—" %>
              </td>

              <td>
                <%= row.free_bytes ?
                      number_to_human_size(row.free_bytes) :
                      "—" %>
              </td>

              <td>
                <%= row.total_bytes ?
                      number_to_human_size(row.total_bytes) :
                      "—" %>
              </td>

              <td style="min-width:160px;">

                <% if row.used_percent %>

                  <div class="progress"
                       role="progressbar"
                       aria-valuenow="<%= row.used_percent %>"
                       aria-valuemin="0"
                       aria-valuemax="100">

                    <div class="progress-bar"
                         style="width:<%= row.used_percent %>%">
                      <%= row.used_percent %>%
                    </div>

                  </div>

                <% else %>

                  <span class="text-muted">—</span>

                <% end %>

              </td>

            </tr>

          <% end %>

        </tbody>

      </table>
    </div>
  </div>


  <!-- ANALYTICS ROW -->

  <div class="row g-4 mb-4">


    <!-- EXTENSIONS -->

    <div class="col-xl-4">

      <div class="card h-100">

        <div class="card-header">
          <strong>File Types</strong>
        </div>

        <div class="table-responsive">

          <table class="table table-sm mb-0">

            <thead>
              <tr>
                <th>Type</th>
                <th class="text-end">Files</th>
                <th class="text-end">Size</th>
              </tr>
            </thead>

            <tbody>

              <% @extension_stats.first(20).each do |row| %>

                <tr>

                  <td>
                    <% unless row.extension == "(none)" %>
                      <%= link_to row.extension.upcase,
                            admin_file_storage_path(
                              extension: row.extension
                            ) %>
                    <% else %>
                      <span class="text-muted">NO EXT</span>
                    <% end %>
                  </td>

                  <td class="text-end">
                    <%= number_with_delimiter(row.files) %>
                  </td>

                  <td class="text-end">
                    <%= number_to_human_size(row.bytes) %>
                  </td>

                </tr>

              <% end %>

            </tbody>

          </table>

        </div>

      </div>

    </div>


    <!-- LARGEST FILES -->

    <div class="col-xl-4">

      <div class="card h-100">

        <div class="card-header">
          <strong>Largest Registered Files</strong>
        </div>

        <div class="table-responsive">

          <table class="table table-sm mb-0">

            <thead>
              <tr>
                <th>File</th>
                <th>Library</th>
                <th class="text-end">Size</th>
              </tr>
            </thead>

            <tbody>

              <% @largest_files.each do |file| %>

                <tr>

                  <td>
                    <div class="text-break">
                      <strong><%= file.filename %></strong>
                    </div>

                    <div class="small text-muted">
                      <%= file.model.name %>
                    </div>
                  </td>

                  <td>
                    <%= file.model.library.name %>
                  </td>

                  <td class="text-end">
                    <%= number_to_human_size(file.size.to_i) %>
                  </td>

                </tr>

              <% end %>

            </tbody>

          </table>

        </div>

      </div>

    </div>


    <!-- LARGEST MODELS -->

    <div class="col-xl-4">

      <div class="card h-100">

        <div class="card-header">
          <strong>Largest Models / Folders</strong>
        </div>

        <div class="table-responsive">

          <table class="table table-sm mb-0">

            <thead>
              <tr>
                <th>Model</th>
                <th>Files</th>
                <th class="text-end">Size</th>
              </tr>
            </thead>

            <tbody>

              <% @largest_models.each do |row| %>

                <tr>

                  <td>
                    <%= link_to row.model.name,
                          model_path(row.model),
                          target: "_blank",
                          rel: "noopener" %>

                    <div class="small text-muted">
                      <%= row.library.name %>
                    </div>
                  </td>

                  <td>
                    <%= number_with_delimiter(row.files) %>
                  </td>

                  <td class="text-end">
                    <%= number_to_human_size(row.bytes) %>
                  </td>

                </tr>

              <% end %>

            </tbody>

          </table>

        </div>

      </div>

    </div>

  </div>


  <!-- INVENTORY FILTER -->

  <div class="card mb-3">

    <div class="card-header">
      <strong>File Inventory</strong>
    </div>

    <div class="card-body">

      <%= form_with url: admin_file_storage_path,
            method: :get,
            local: true,
            class: "row g-2" do %>

        <div class="col-lg-4">

          <%= text_field_tag :q,
                @query,
                class: "form-control",
                placeholder: "Search model, folder or filename" %>

        </div>

        <div class="col-lg-3">

          <%= select_tag :library_id,
                options_from_collection_for_select(
                  @libraries,
                  :id,
                  :name,
                  @library_id
                ),
                include_blank: "All libraries",
                class: "form-select" %>

        </div>

        <div class="col-lg-2">

          <%= select_tag :extension,
                options_for_select(
                  @extensions.map { |ext| [ext.upcase, ext] },
                  @extension
                ),
                include_blank: "All extensions",
                class: "form-select" %>

        </div>

        <div class="col-lg-2">

          <%= select_tag :source_state,
                options_for_select(
                  [
                    ["All source states", ""],
                    ["Present", "present"],
                    ["Missing", "missing"]
                  ],
                  @source_state
                ),
                class: "form-select" %>

        </div>

        <div class="col-lg-1 d-grid">
          <%= submit_tag "Filter",
                class: "btn btn-primary" %>
        </div>

      <% end %>

    </div>
  </div>


  <!-- INVENTORY TABLE -->

  <div class="card">

    <div class="table-responsive">

      <table class="table table-sm table-striped align-middle mb-0">

        <thead>
          <tr>
            <th>File</th>
            <th>Folder</th>
            <th>Model</th>
            <th>Library</th>
            <th>Storage</th>
            <th>Relative path</th>
            <th>Size</th>
            <th>Modified</th>
            <th>Source</th>
            <th>Render</th>
          </tr>
        </thead>

        <tbody>

          <% @rows.each do |row| %>

            <tr>

              <td>

                <strong><%= row.filename %></strong>

                <div class="small text-muted">
                  #<%= row.model_file.id %>
                  ·
                  <%= row.extension.upcase.presence || "NO EXT" %>
                </div>

              </td>

              <td>
                <strong><%= row.folder_name %></strong>
              </td>

              <td>

                <%= link_to row.model.name,
                      model_path(row.model),
                      target: "_blank",
                      rel: "noopener" %>

                <div class="small text-muted">
                  Model #<%= row.model.id %>
                </div>

              </td>

              <td>
                <%= row.library.name %>
              </td>

              <td>

                <code><%= row.storage_key %></code>

                <div class="small text-muted">
                  <%= row.library.storage_service %>
                </div>

                <% if row.physical_path.present? %>

                  <details class="small mt-1">

                    <summary>Physical path</summary>

                    <code class="text-break">
                      <%= row.physical_path %>
                    </code>

                  </details>

                <% end %>

              </td>

              <td>
                <code class="text-break">
                  <%= row.relative_path %>
                </code>
              </td>

              <td>
                <%= number_to_human_size(row.size.to_i) %>
              </td>

              <td>
                <%= row.modified_at&.strftime("%Y-%m-%d %H:%M") || "—" %>
              </td>

              <td>

                <span class="badge <%= row.source_exists ? 'bg-success' : 'bg-danger' %>">
                  <%= row.source_exists ? "Present" : "Missing" %>
                </span>

              </td>

              <td>

                <span class="badge <%= row.has_render ? 'bg-success' : 'bg-secondary' %>">
                  <%= row.has_render ? "Cached" : "No" %>
                </span>

              </td>

            </tr>

          <% end %>

        </tbody>

      </table>

    </div>

  </div>


  <% if @rows.empty? %>

    <div class="alert alert-light border mt-3">
      No registered model files match the current filters.
    </div>

  <% elsif @rows.size >= 250 %>

    <div class="alert alert-light border mt-3 mb-0">
      Showing the first 250 matching registered files.
      Narrow the filters to inspect a smaller set.
    </div>

  <% end %>

  <%= render "admin/file_storage/activity_footer" %>

</div>
