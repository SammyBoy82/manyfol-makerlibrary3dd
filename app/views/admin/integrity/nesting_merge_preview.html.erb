<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h3 mb-1">Nesting Merge Impact Preview</h1>
      <p class="text-muted mb-0">Read-only preview of exactly what a parent/child model merge would change.</p>
      <div class="small text-muted mt-1">Generated <%= time_ago_in_words(@preview.generated_at) %> ago</div>
    </div>
    <%= link_to "Back to Nesting Review", admin_integrity_nesting_path, class: "btn btn-outline-primary" %>
  </div>

  <div class="alert alert-warning">
    <strong>Preview only — no merge is enabled.</strong>
    This page models Manyfold's native merge behavior so you can review file moves, duplicate handling and metadata inheritance before any Apply action exists.
  </div>

  <div class="row g-3 mb-4">
    <div class="col-lg-6">
      <div class="card h-100 border-success">
        <div class="card-header"><strong>KEEP — Parent Model</strong></div>
        <div class="card-body">
          <h2 class="h5"><%= @preview.parent[:name] %></h2>
          <div class="small text-muted">Model #<%= @preview.parent[:id] %> · <%= @preview.parent[:library] %></div>
          <div class="mt-2"><code><%= @preview.parent[:path] %></code></div>
          <div class="mt-2"><%= @preview.parent[:files] %> files · <%= @preview.parent[:three_d] %> 3D · <%= @preview.parent[:images] %> images</div>
          <div class="mt-2 small">Parent name and catalogue path remain unchanged.</div>
        </div>
      </div>
    </div>

    <div class="col-lg-6">
      <div class="card h-100 border-danger">
        <div class="card-header"><strong>MERGE INTO PARENT — Child Model</strong></div>
        <div class="card-body">
          <h2 class="h5"><%= @preview.child[:name] %></h2>
          <div class="small text-muted">Model #<%= @preview.child[:id] %> · <%= @preview.child[:library] %></div>
          <div class="mt-2"><code><%= @preview.child[:path] %></code></div>
          <div class="mt-2"><%= @preview.child[:files] %> files · <%= @preview.child[:three_d] %> 3D · <%= @preview.child[:images] %> images</div>
          <div class="mt-2 small text-danger"><strong>The child catalogue record would be destroyed after a successful merge.</strong></div>
        </div>
      </div>
    </div>
  </div>

  <div class="card mb-4">
    <div class="card-header"><strong>File Impact</strong> · child relative path <code><%= @preview.relative_path %></code></div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-sm table-striped align-middle mb-0">
          <thead>
            <tr>
              <th>ModelFile</th>
              <th>Current Source</th>
              <th>Destination inside Parent</th>
              <th>Type</th>
              <th>Storage</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% @preview.files.each do |file| %>
              <tr>
                <td><code>#<%= file[:id] %></code><div class="small text-muted"><%= number_to_human_size(file[:size]) if file[:size] %></div></td>
                <td><code class="text-break"><%= file[:source_path] %></code></td>
                <td><code class="text-break"><%= file[:destination_filename] %></code></td>
                <td>
                  <span class="badge bg-light text-dark border"><%= file[:extension] %></span>
                  <% if file[:is_3d_model] %><span class="badge bg-primary">3D</span><% end %>
                  <% if file[:is_image] %><span class="badge bg-info text-dark">image</span><% end %>
                </td>
                <td>
                  <% if file[:storage_exists] == true %><span class="badge bg-success">Exists</span>
                  <% elsif file[:storage_exists] == false %><span class="badge bg-danger">Missing</span>
                  <% else %><span class="badge bg-secondary">Unknown</span><% end %>
                </td>
                <td>
                  <% if file[:action] == :deduplicate_database_record %>
                    <span class="badge bg-warning text-dark">Identical parent copy already exists</span>
                    <div class="small mt-1">Child DB file record would be discarded; existing parent file kept.</div>
                  <% else %>
                    <span class="badge bg-success">Adopt into parent</span>
                    <% if file[:conflict] %><div class="small text-warning mt-1">Filename conflict: digest suffix would be added.</div><% end %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <% if @preview.files.empty? %><div class="p-3 text-muted">Child contains no ModelFile records.</div><% end %>
    </div>
  </div>

  <div class="card mb-4">
    <div class="card-header"><strong>Metadata Impact</strong></div>
    <div class="card-body">
      <div class="table-responsive">
        <table class="table table-sm align-middle">
          <thead><tr><th>Field</th><th>Parent now</th><th>Child</th><th>Merge result</th></tr></thead>
          <tbody>
            <% {creator: "Creator", license: "License", caption: "Caption"}.each do |key, label| %>
              <% item = @preview.metadata[key] %>
              <tr>
                <td><strong><%= label %></strong></td>
                <td><%= item[:parent].presence || "—" %></td>
                <td><%= item[:child].presence || "—" %></td>
                <td>
                  <% if item[:action] == :inherit_child %><span class="badge bg-info text-dark">inherit child value</span>
                  <% elsif item[:action] == :keep_parent %><span class="badge bg-success">keep parent value</span>
                  <% else %><span class="badge bg-secondary">remain blank</span><% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="row g-3">
        <div class="col-md-4"><div class="border rounded p-3 h-100"><strong>Collections added</strong><div class="mt-2"><%= @preview.metadata[:collections_added].presence&.join(", ") || "None" %></div></div></div>
        <div class="col-md-4"><div class="border rounded p-3 h-100"><strong>Tags added</strong><div class="mt-2"><%= @preview.metadata[:tags_added].presence&.join(", ") || "None" %></div></div></div>
        <div class="col-md-4"><div class="border rounded p-3 h-100"><strong>Links added</strong><div class="mt-2 text-break"><%= @preview.metadata[:links_added].presence&.join(", ") || "None" %></div></div></div>
      </div>
    </div>
  </div>

  <div class="card border-warning">
    <div class="card-header"><strong>Safety / Consequences</strong></div>
    <div class="card-body">
      <ul class="mb-3">
        <% @preview.warnings.each do |warning| %><li><%= warning %></li><% end %>
      </ul>
      <button class="btn btn-danger" disabled>Merge Child Into Parent — disabled in Phase 4.8</button>
      <span class="small text-muted ms-2">Phase 4.9 will add explicit Apply only after this preview is validated.</span>
    </div>
  </div>
</div>
