<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h3 mb-1">Media & Render Maintenance</h1>
      <p class="text-muted mb-0">
        Library-level preview health, queue status, repair, and rescan tools.
      </p>
    </div>
    <%= link_to "Admin Operations", admin_operations_path, class: "btn btn-outline-secondary" %>
  </div>

  <div class="row g-3 mb-4">
    <div class="col-6 col-md-3 col-xl-2">
      <div class="card h-100"><div class="card-body">
        <div class="text-muted small">Performance Queue</div>
        <div class="h4 mb-0"><%= @queue_status[:performance] %></div>
      </div></div>
    </div>
    <div class="col-6 col-md-3 col-xl-2">
      <div class="card h-100"><div class="card-body">
        <div class="text-muted small">Default Queue</div>
        <div class="h4 mb-0"><%= @queue_status[:default] %></div>
      </div></div>
    </div>
    <div class="col-6 col-md-3 col-xl-2">
      <div class="card h-100"><div class="card-body">
        <div class="text-muted small">Scan Queue</div>
        <div class="h4 mb-0"><%= @queue_status[:scan] %></div>
      </div></div>
    </div>
    <div class="col-6 col-md-3 col-xl-2">
      <div class="card h-100"><div class="card-body">
        <div class="text-muted small">Retries</div>
        <div class="h4 mb-0"><%= @queue_status[:retries] %></div>
      </div></div>
    </div>
    <div class="col-6 col-md-3 col-xl-2">
      <div class="card h-100"><div class="card-body">
        <div class="text-muted small">Scheduled</div>
        <div class="h4 mb-0"><%= @queue_status[:scheduled] %></div>
      </div></div>
    </div>
    <div class="col-6 col-md-3 col-xl-2">
      <div class="card h-100"><div class="card-body">
        <div class="text-muted small">Sidekiq Processes</div>
        <div class="h4 mb-0"><%= @queue_status[:processes] %></div>
      </div></div>
    </div>
  </div>

  <div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
      <thead>
        <tr>
          <th>Library</th>
          <th>3D Files</th>
          <th>Healthy</th>
          <th>Stale</th>
          <th>Orphan</th>
          <th>Missing Render</th>
          <th>Missing Source</th>
          <th>Unsupported</th>
          <th style="min-width: 300px;">Actions</th>
        </tr>
      </thead>

      <tbody>
        <% @health.each do |health| %>
          <tr>
            <td><strong><%= health.library.name %></strong></td>
            <td><%= health.total_3d %></td>

            <td><span class="badge bg-success"><%= health.healthy %></span></td>
            <td><span class="badge bg-warning text-dark"><%= health.stale_metadata %></span></td>
            <td><span class="badge bg-info text-dark"><%= health.orphan_render %></span></td>
            <td><span class="badge bg-danger"><%= health.missing_renderable %></span></td>

            <td>
              <% if health.missing_source.to_i > 0 %>
                <%= link_to(
                      health.missing_source,
                      admin_media_maintenance_missing_sources_path(health.library.id),
                      class: "badge bg-secondary text-decoration-none"
                    ) %>
              <% else %>
                <span class="badge bg-secondary">0</span>
              <% end %>
            </td>

            <td>
              <% if health.unsupported.any? %>
                <% health.unsupported.sort.each do |ext, count| %>
                  <span class="badge bg-light text-dark border">
                    <%= ext.upcase %>: <%= count %>
                  </span>
                <% end %>
              <% else %>
                -
              <% end %>
            </td>

            <td>
              <div class="d-flex flex-wrap gap-1">
                <%= button_to(
                      "Rescan",
                      admin_media_maintenance_rescan_path(health.library.id),
                      method: :post,
                      class: "btn btn-sm btn-outline-secondary",
                      data: {turbo_confirm: "Queue a filesystem rescan for #{health.library.name}?"}
                    ) %>

                <%= button_to(
                      "Repair Stale (#{health.stale_metadata})",
                      admin_media_maintenance_repair_stale_path(health.library.id),
                      method: :post,
                      class: "btn btn-sm btn-warning",
                      disabled: health.stale_metadata.to_i.zero?,
                      data: {turbo_confirm: "Queue stale render repairs for #{health.library.name}?"}
                    ) %>

                <%= button_to(
                      "Repair Orphans (#{health.orphan_render})",
                      admin_media_maintenance_repair_orphans_path(health.library.id),
                      method: :post,
                      class: "btn btn-sm btn-info",
                      disabled: health.orphan_render.to_i.zero?,
                      data: {turbo_confirm: "Queue orphan render repairs for #{health.library.name}?"}
                    ) %>

                <%= button_to(
                      "Generate Missing (#{health.missing_renderable})",
                      admin_media_maintenance_regenerate_missing_path(health.library.id),
                      method: :post,
                      class: "btn btn-sm btn-primary",
                      disabled: health.missing_renderable.to_i.zero?,
                      data: {turbo_confirm: "Queue missing renderable files in #{health.library.name}?"}
                    ) %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="mt-3 small text-muted">
    Dead jobs: <%= @queue_status[:dead] %> &middot;
    Critical queue: <%= @queue_status[:critical] %>
  </div>
</div>
