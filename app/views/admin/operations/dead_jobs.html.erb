<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h3 mb-1">Dead Jobs</h1>
      <p class="text-muted mb-0">Inspect, retry, or delete failed Sidekiq jobs.</p>
    </div>
    <div class="d-flex gap-2">
      <%= link_to "Control Center", admin_operations_control_center_path, class: "btn btn-outline-primary" %>
      <%= link_to "Admin Operations", admin_operations_path, class: "btn btn-outline-secondary" %>
      <% if @jobs.any? %>
        <%= button_to "Clear All", admin_operations_clear_dead_jobs_path, method: :delete, class: "btn btn-danger", data: {turbo_confirm: "Delete all dead Sidekiq jobs?"} %>
      <% end %>
    </div>
  </div>

  <div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
      <thead>
        <tr>
          <th>JID</th>
          <th>Class</th>
          <th>Queue</th>
          <th>Error</th>
          <th>Failed</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if @jobs.any? %>
          <% @jobs.each do |job| %>
            <% item = job.item || {} %>
            <% error_message = item["error_message"].presence || "Unknown error" %>
            <% failed_raw = item["failed_at"] %>
            <% failed_time = failed_raw.present? ? Time.at(failed_raw.to_f / 1000.0) : nil %>
            <tr>
              <td><code><%= job.jid %></code></td>
              <td><%= job.display_class %></td>
              <td><span class="badge bg-secondary"><%= job.queue %></span></td>
              <td style="max-width: 520px;"><div class="text-break"><%= error_message %></div></td>
              <td><%= failed_time ? time_ago_in_words(failed_time) + " ago" : "-" %></td>
              <td>
                <div class="d-flex flex-wrap gap-1">
                  <%= button_to "Retry", admin_operations_retry_dead_job_path(job.jid), method: :post, class: "btn btn-sm btn-warning", data: {turbo_confirm: "Retry this job?"} %>
                  <%= button_to "Delete", admin_operations_delete_dead_job_path(job.jid), method: :delete, class: "btn btn-sm btn-outline-danger", data: {turbo_confirm: "Delete this dead job permanently?"} %>
                </div>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr><td colspan="6" class="text-muted">No dead jobs.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
