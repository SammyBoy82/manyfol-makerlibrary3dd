<p>Hello <%= @resource.email %>,</p>

<p>
  You have been invited to join <strong>MakerLibrary3D</strong>.
</p>

<% if @resource.membership_plan.present? %>
  <p>
    Your assigned membership plan is
    <strong><%= @resource.membership_plan.name %></strong>.
  </p>
<% end %>

<p>
  <%= link_to "Accept secure invitation",
        accept_invitation_url(@resource, invitation_token: @token),
        class: "button" %>
</p>

<% if @resource.invitation_due_at %>
  <p>
    This single-use invitation expires on
    <strong><%= @resource.invitation_due_at.in_time_zone.to_fs(:long) %></strong>.
  </p>
<% end %>

<p>
  If you were not expecting this invitation, ignore this message. The link can
  only be used once, and your account will not be activated until it is accepted.
</p>
