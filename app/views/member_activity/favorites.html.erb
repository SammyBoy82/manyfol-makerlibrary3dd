<div class="container-fluid py-4">
  <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
      <h1 class="mb-1">Favorites</h1>
      <p class="text-muted mb-0">Models you have saved for quick access.</p>
    </div>
    <%= link_to "Back to Dashboard", dashboard_path, class: "btn btn-outline-secondary" %>
  </div>

  <% if @models.any? %>
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-3">
      <% @models.each do |model| %>
        <div class="col">
          <div class="card h-100">
            <div class="card-body">
              <h2 class="h5"><%= link_to model.name, model_path(model), class: "text-decoration-none" %></h2>
              <% if model.library %>
                <div class="small text-muted"><%= model.library.name %></div>
              <% end %>
            </div>
            <div class="card-footer bg-transparent">
              <%= link_to "Open Model", model_path(model), class: "btn btn-sm btn-outline-primary w-100" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
    <div class="mt-4"><%= paginate @models %></div>
  <% else %>
    <div class="alert alert-info">
      You have no favorites yet. Use the Like button on a model to add it here.
    </div>
  <% end %>
</div>
