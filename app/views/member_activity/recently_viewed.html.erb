<div class="container-fluid py-4">
  <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
      <h1 class="mb-1">Recently Viewed</h1>
      <p class="text-muted mb-0">Models you recently opened.</p>
    </div>
    <div class="d-flex gap-2">
      <% if @model_views.any? %>
        <%= button_to "Clear History",
              member_clear_recently_viewed_path,
              method: :delete,
              class: "btn btn-outline-danger",
              form: {data: {turbo_confirm: "Clear all recently viewed history?"}} %>
      <% end %>
      <%= link_to "Back to Dashboard", dashboard_path, class: "btn btn-outline-secondary" %>
    </div>
  </div>

  <% if @model_views.any? %>
    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <th>Model</th>
            <th>Library</th>
            <th>Views</th>
            <th>Last Viewed</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @model_views.each do |view| %>
            <tr>
              <td><%= view.model.name %></td>
              <td><%= view.model.library&.name || "—" %></td>
              <td><%= view.view_count %></td>
              <td><%= time_ago_in_words(view.last_viewed_at) %> ago</td>
              <td class="text-end"><%= link_to "Open", model_path(view.model), class: "btn btn-sm btn-outline-primary" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= paginate @model_views %>
  <% else %>
    <div class="alert alert-info">No recently viewed models yet.</div>
  <% end %>
</div>
