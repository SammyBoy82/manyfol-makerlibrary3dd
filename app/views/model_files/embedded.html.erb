<% if @file.has_render? %>
  <%# MakerLibrary3D: use persistent render before interactive Three.js %>
  <%= image_tag(
        model_model_file_path(
          @file.model,
          @file,
          format: @file.extension,
          derivative: "render"
        ),
        style: "width: 100%",
        class: "image-preview",
        alt: @file.name
      ) %>
<% elsif (handler = FileHandlers.handlers_for(
            environment: :browser,
            mime_type: @file.mime_type
          )&.first) %>
  <%= render handler.component.new(file: @file) %>
<% end %>
